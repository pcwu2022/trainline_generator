@@ -0,0 +1,9 @@
+"""Annual investment value shared by infrastructure and service selection."""
+
+
+def growth_value(metrics, reward_eur_per_trip):
+    """Financial net plus an explicit service reward, in annual euros.
+
+    The reward is a search policy parameter, not a calibrated welfare estimate.
+    """
+    return metrics['net_eur'] + reward_eur_per_trip * metrics['passengers']
