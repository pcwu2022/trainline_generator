+"""Investment decisions value revenue and service, independent of route length."""
+from dataclasses import replace
+from types import SimpleNamespace
+from unittest import TestCase
+from unittest.mock import patch
+
+import numpy as np
+
+from rail_gen.config import load_config
+from rail_gen.evaluator import Evaluator
+from rail_gen.incremental import growth_choice, connectivity_choice, integration_choice, combined_choice, connectivity_target_due
