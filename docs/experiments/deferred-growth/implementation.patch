+
+
+def result(trips=0, cost=0, revenue=0, genome=(0, 0, 0), population=0):
+    return SimpleNamespace(genome=np.array(genome), objectives=[cost-revenue],
+        constraints=np.zeros(5), metrics=dict(passengers=trips, annual_cost_eur=cost,
+        net_eur=revenue-cost, population_served=population))
+
+
+class GrowthValueTests(TestCase):
+    def test_productive_long_route_beats_cheap_short_link(self):
+        current = result()
+        short = result(10e6, 20e6, 15e6)
+        long = result(5e6, 60e6, 65e6)
+        # A sufficiently valuable long route wins; this example needs a reward
+        # below EUR4/trip, since the short link carries 5m additional people.
+        self.assertIs(growth_choice(current, [short, long], 1), long)
+        self.assertIs(growth_choice(current, [short, long], 5), short)
+
+    def test_saved_paris_lyon_increment_beats_rotterdam_under_default_reward(self):
+        paris = result(37.766e6, 1102.541e6, 1711.765e6)
+        rotterdam = result(58.752e6, 105.420e6, 105.545e6)
+        self.assertIs(growth_choice(result(), [rotterdam, paris]), paris)
+
+    def test_negative_and_break_even_value_rejected(self):
+        self.assertIsNone(growth_choice(result(), [result(1e6, 6e6)], 5))
+        self.assertIsNone(growth_choice(result(), [result(1e6, 5e6)], 5))
+        self.assertIsNotNone(growth_choice(result(), [result(1e6, 4e6)], 5))
+
+    def test_preserves_ridership_and_population_but_allows_financial_savings(self):
+        current = result(10, 100, population=10)
+        self.assertIsNone(growth_choice(current, [result(9, 0, population=10)]))
+        self.assertIsNone(growth_choice(current, [result(11, 0, population=9)]))
+        saving = result(10, 90, population=10)
+        self.assertIs(growth_choice(current, [saving]), saving)
+
+    def test_combined_investment_must_improve_value_over_best_single(self):
+        current = result()
+        a = result(10, 0, genome=(1, 0, 0))
+        b = result(9, 0, genome=(0, 1, 0))
+        combined = result(11, 20, genome=(1, 1, 0))
+        selected, evaluated = combined_choice(current, [a, b], growth_choice,
+                                             lambda _: combined, 10)
+        self.assertIs(selected, a)  # 35 euros combined versus 50 for a.
+        self.assertEqual(evaluated, [combined])
+
+    def test_merger_requires_positive_value_and_preserves_coverage(self):
+        c = config()
+        base = graph_fixture()
+        cities = base.cities + [replace(base.cities[-1], id='d', name='D', lon=7)]
+        edges = [replace(edge, a=a, b=b) for edge, (a, b) in
+                 zip(base.edges, [(0, 1), (2, 3), (1, 2)])]
+        e = Evaluator(graph_fixture(cities=cities, edges=edges), c)
+        current = result(genome=(1, 1, 0))
+        merger = result(100, 400, genome=(1, 1, 1))
+        self.assertIs(connectivity_choice(current, [merger], e), merger)
+        merger.metrics['net_eur'] = -600
+        self.assertIsNone(connectivity_choice(current, [merger], e))
+        self.assertIsNone(integration_choice(current, [merger], e, 5))
+
+    def test_service_plan_selection_uses_same_value(self):
+        e = Evaluator(graph_fixture(), config())
+        incumbent = e.evaluate([0, 0, 0])
+        short = result(58.752e6, 105.420e6, 105.545e6)
+        long = result(37.766e6, 1102.541e6, 1711.765e6)
+        network = SimpleNamespace(services=())
+        with patch('rail_gen.evaluator.generate_plans', return_value=[network]), \
